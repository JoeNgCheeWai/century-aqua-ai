ANTHROPIC_API_KEY=your-key-here
GATEKEEPER_MODEL=claude-haiku-5-5
SPECIALIST_MODEL=claude-sonnet-5-5
# AI_CAO (Tier 2) - INTERNAL-ONLY endpoint /api/cao (never public)
# INTERNAL_CAO_KEY is required: callers must send it in the X-Internal-CAO-Key header.
# Without it the endpoint stays disabled (503).
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_CAO_KEY=
CAO_MODEL=claude-sonnet-5-5
CAO_MAX_TOKENS=8192
# AI_COO (Phase 2) - INTERNAL-ONLY endpoint /api/coo (never public). Its own key, sent in the
# X-Internal-COO-Key header. Without INTERNAL_COO_KEY (below) the endpoint stays disabled (503).
COO_MODEL=claude-sonnet-5-5
COO_MAX_TOKENS=16384
# AI_CTO (Phase 3) - INTERNAL-ONLY endpoint /api/cto (never public). Its own key, sent in the
# X-Internal-CTO-Key header. Without INTERNAL_CTO_KEY (below) the endpoint stays disabled (503).
# The CTO never executes a change: it returns an authorization_request for a human to approve.
CTO_MODEL=claude-sonnet-5-5
CTO_MAX_TOKENS=16384
# AI_CMO (Phase 4) - INTERNAL-ONLY endpoint /api/cmo (never public). Its own key, sent in the
# X-Internal-CMO-Key header. Without INTERNAL_CMO_KEY (below) the endpoint stays disabled (503).
# The CMO drafts freely but never publishes: it returns an authorization_request for a human to approve.
CMO_MODEL=claude-sonnet-5-5
CMO_MAX_TOKENS=16384
# Constitutional Governance (see PROJECT_CONTEXT.md, Section 11).
# INTERNAL_COO_KEY gates POST /api/coo (the AI_COO), in the X-Internal-COO-Key header. It must be a
# random 64-character hex string; keep it secret and add it to Vercel (server-side) as well.
# Generate one, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_COO_KEY=
# INTERNAL_CTO_KEY gates POST /api/cto (the AI_CTO), in the X-Internal-CTO-Key header. Same format and
# rules as INTERNAL_COO_KEY: a random 64-character hex string, secret, and a DIFFERENT value from the others.
INTERNAL_CTO_KEY=
# INTERNAL_CMO_KEY gates POST /api/cmo (the AI_CMO), in the X-Internal-CMO-Key header. Same format and
# rules as the other executive keys: a random 64-character hex string, secret, and a DIFFERENT value from the others.
INTERNAL_CMO_KEY=
# Database for the audit log, agent state and kill switch. Use the SAME database as the frontend
# (Neon in production, the DIRECT non-pooled URL is fine). Falls back to DATABASE_URL if unset.
# Without it the agents still answer, but nothing is audit-logged and the kill switch returns 503.
# Local development: the `prisma dev` URL with sslmode=disable.
GOVERNANCE_DATABASE_URL=
# RAG knowledge base for the AI_CAO (optional; without these the AI_CAO answers without documents).
# Pinecone index: dimension 1536, metric cosine (OpenAI text-embedding-3-small).
PINECONE_API_KEY=
PINECONE_INDEX=
OPENAI_API_KEY=
# Optional: the OpenAI image model for app/agents/image_tool.py (not wired into any agent yet). DALL-E 3 was shut down on
# May 12, 2026, so the default is a GPT Image model. Without OPENAI_API_KEY the tool falls back to the placeholder image.
# OPENAI_IMAGE_MODEL=gpt-image-1-mini
# Optional: your email, sent to Crossref/NCBI by scripts/auto_fetch_literature.py as a courtesy contact.
CONTACT_EMAIL=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: regex for Vercel preview deployments, e.g.
# ALLOWED_ORIGIN_REGEX=https://caip-frontend-.*-yourteam\.vercel\.app
ALLOWED_ORIGIN_REGEX=

# AI Executive Council (Phase 5) - INTERNAL-ONLY endpoints POST /api/council and GET /api/council/{session_id}.
# INTERNAL_COUNCIL_KEY gates both, in the X-Internal-Council-Key header. A random 64-character hex string, secret,
# and a DIFFERENT value from every agent key. Without it the endpoints answer 503. The council needs the database
# migration add_council_protocol applied (prisma migrate deploy) and GOVERNANCE_DATABASE_URL set.
INTERNAL_COUNCIL_KEY=
COUNCIL_MODEL=claude-sonnet-5-5
# Phase 6.5 model tiers: what "haiku", "sonnet" and "opus" mean in the Mission Control model picker (optional; these are the defaults).
HAIKU_MODEL=claude-haiku-5-5
SONNET_MODEL=claude-sonnet-5-5
OPUS_MODEL=claude-opus-5-5

# Phase 6.6 autonomous workflow: a fine-grained GitHub token (Contents and Pull requests: read and write, this one repository).
# Backend only. Used to open pull requests after a human approves a plan; it cannot merge. Leave it empty to turn the feature off.
GITHUB_PAT=
# Optional: the one repository the tools may touch (they default to this project's own).
# GITHUB_OWNER=
# GITHUB_REPO=
# Per-turn output cap (agent turns), chair-turn cap (COO moderation / red team, CAO synthesis), and the session ceilings.
COUNCIL_TURN_MAX_TOKENS=600
COUNCIL_CHAIR_MAX_TOKENS=1200
COUNCIL_MAX_CALLS=10
COUNCIL_MAX_INPUT_TOKENS=40000
COUNCIL_MAX_OUTPUT_TOKENS=10000
COUNCIL_MAX_CONCURRENT=3

# claude-sonnet-5-5 thinks by default and thinking tokens count against max_tokens (the first live council run spent
# its whole 600-token cap on an empty thinking block). The council turns thinking off with this type. The model rejects
# 'disabled'; 'between_tools' is its way of turning thinking off. Set to 'omit' to send no thinking parameter.
COUNCIL_THINKING=between_tools

# Mission Control (Phase 6) - the Next.js console under /mission-control. Its three backend endpoints
# (GET /api/audit-logs, POST /api/authorization/{id}/approve|reject, GET /api/council/sessions) are gated by
# INTERNAL_COUNCIL_KEY above, so there is nothing new to set on the backend for them. The migration add_human_action_audit
# (prisma migrate deploy) must be applied for approve and reject to work; the read endpoints work without it.
# ADMIN_PIN and ADMIN_SESSION_SECRET are read by the FRONTEND only (see frontend/.env.example). They are listed here so every
# secret of the project is recorded in one place; the backend ignores them.
ADMIN_PIN=
ADMIN_SESSION_SECRET=
