ANTHROPIC_API_KEY=your-key-here
GATEKEEPER_MODEL=claude-haiku-5-5
SPECIALIST_MODEL=claude-sonnet-5-5
# AI_CAO (Tier 2) - INTERNAL-ONLY endpoint /api/cao (never public)
# INTERNAL_CAO_KEY is required: callers must send it in the X-Internal-CAO-Key header.
# Without it the endpoint stays disabled (503).
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_CAO_KEY=
CAO_MODEL=claude-sonnet-5-5
CAO_MAX_TOKENS=8192
# AI_COO (Phase 2) - INTERNAL-ONLY endpoint /api/coo (never public). Its own key, sent in the
# X-Internal-COO-Key header. Without INTERNAL_COO_KEY (below) the endpoint stays disabled (503).
COO_MODEL=claude-sonnet-5-5
COO_MAX_TOKENS=16384
# Constitutional Governance (see PROJECT_CONTEXT.md, Section 11).
# INTERNAL_COO_KEY gates POST /api/coo (the AI_COO), in the X-Internal-COO-Key header. It must be a
# random 64-character hex string; keep it secret and add it to Vercel (server-side) as well.
# Generate one, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_COO_KEY=
# Database for the audit log, agent state and kill switch. Use the SAME database as the frontend
# (Neon in production, the DIRECT non-pooled URL is fine). Falls back to DATABASE_URL if unset.
# Without it the agents still answer, but nothing is audit-logged and the kill switch returns 503.
# Local development: the `prisma dev` URL with sslmode=disable.
GOVERNANCE_DATABASE_URL=
# RAG knowledge base for the AI_CAO (optional; without these the AI_CAO answers without documents).
# Pinecone index: dimension 1536, metric cosine (OpenAI text-embedding-3-small).
PINECONE_API_KEY=
PINECONE_INDEX=
OPENAI_API_KEY=
# Optional: your email, sent to Crossref/NCBI by scripts/auto_fetch_literature.py as a courtesy contact.
CONTACT_EMAIL=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: regex for Vercel preview deployments, e.g.
# ALLOWED_ORIGIN_REGEX=https://caip-frontend-.*-yourteam\.vercel\.app
ALLOWED_ORIGIN_REGEX=
