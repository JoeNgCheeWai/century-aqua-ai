// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Subscription tier. Free users get the small limit; pro/research/enterprise
// share the paid limit; internal staff are unmetered (see src/lib/rate-limit.ts).
enum Role {
  free
  pro
  research
  enterprise
  internal
}

// One row per Clerk user, created lazily on their first dashboard visit or chat.
model User {
  id               String    @id @default(cuid())
  // Clerk's userId (e.g. "user_2abc..."). The link between Clerk and this database.
  clerkId          String    @unique
  role             Role      @default(free)
  // Messages used in the current session window.
  messageCount     Int       @default(0)
  // When the current window ends; the count resets to 0 after this moment.
  sessionResetTime DateTime
  // Purchased top-up credits (not spent by the rate limiter yet).
  tokenBalance     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  // Set when an admin bans the user (soft delete). Banned users are refused everywhere.
  bannedAt         DateTime?
}

// ---------- Internal Dashboard (/internal) and Command Centre (/admin) ----------
// Every "userId" below is a Clerk user id (User.clerkId). agentType is 'dr_aqua' | 'cao'
// and role is 'user' | 'assistant' | 'system'; both are plain strings checked in code.

// One row per call to /api/chat or /api/cao, written in the background.
model QueryLog {
  id           Int      @id @default(autoincrement())
  userId       String?
  agentType    String
  timestamp    DateTime @default(now())
  success      Boolean
  tokenCount   Int?
  errorMessage String?
  ipAddress    String?

  @@index([timestamp])
  @@index([userId, timestamp])
  @@index([agentType, timestamp])
}

// A shared chat where several staff and one AI agent talk together.
model MeetingRoom {
  id           Int              @id @default(autoincrement())
  name         String
  createdBy    String
  participants String[]         @default([])
  agentType    String
  createdAt    DateTime         @default(now())
  messages     MeetingMessage[]

  @@index([createdBy])
}

model MeetingMessage {
  id        Int         @id @default(autoincrement())
  roomId    Int
  room      MeetingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String? // null for AI and system messages
  message   String
  role      String
  timestamp DateTime    @default(now())

  @@index([roomId, timestamp])
}

model InternalProject {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  createdBy   String
  members     String[]       @default([])
  createdAt   DateTime       @default(now())
  chats       InternalChat[]

  @@index([createdBy])
}

// One row per message in a staff chat (separate from subscriber chats).
model InternalChat {
  id        Int              @id @default(autoincrement())
  userId    String
  projectId Int?
  project   InternalProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agentType String
  message   String
  role      String
  timestamp DateTime         @default(now())

  @@index([userId, timestamp])
  @@index([projectId, timestamp])
}

// ---------- Constitutional AI Governance (executive agents: AI_CAO, future AI_COO, ...) ----------
// Written by the Python backend (backend/app/governance) with raw SQL, which is why the ids are
// database-generated integers. agentId values are 'cao', 'coo', ... (see backend/app/agents/registry.py).

// What a human decided about an agent's recommendation.
enum HumanAction {
  Approved
  Modified
  Rejected
  Pending
}

// One row per executive agent: a small rolling buffer of its recent exchanges, the reset counter
// and the violation count. The kill switch clears the buffer and bumps resetEpoch.
model AgentState {
  id                       Int       @id @default(autoincrement())
  agentId                  String    @unique
  // Last few exchanges, [{at, userId, query, reply}], capped by the backend. Never fed back to the model.
  conversationHistory      Json      @default("[]")
  // Incremented by every kill-switch reset. Callers that hold their own history send the epoch they
  // saw; a stale epoch means the history was cancelled and is ignored.
  resetEpoch               Int       @default(0)
  lastReset                DateTime?
  // Responses whose automatic constitutional score fell below the review threshold.
  constitutionalViolations Int       @default(0)
  updatedAt                DateTime  @updatedAt
}

// One row per executive-agent response, kept for accountability (Clause 6). NOT cleared by a reset.
model AgentAuditLog {
  id                      Int         @id @default(autoincrement())
  agentId                 String
  userId                  String
  query                   String
  response                String
  // Automatic surface check (1-100), see backend/app/governance/scoring.py. NOT a real evaluation.
  constitutionalScore     Int
  sourcesCited            String[]    @default([])
  // CAO Enhanced Reasoning & Prediction (Phase 1). Written by backend/app/governance/audit.py.
  // reasoningChain: the CAO's step-by-step logic, data points and sources, assumptions and limitations.
  reasoningChain          String[]    @default([])
  // {optimistic, baseline, pessimistic}, each with description, timeline, resource_requirements,
  // confidence_percentage, key_assumptions, risks. NULL when the question was not a strategic one
  // and for rows written before this field existed.
  scenarios               Json?
  // {coo_query, cto_query}. Structure only for now: nothing consumes it until the Council Protocol.
  preConsultationRequests Json?
  // The Authorization Workflow (Phases 3 and 4): a proposed action waiting for a human. Written by TWO agents with
  // DIFFERENT shapes, so read agentId first:
  //   agentId 'cto' (code or system change): {action_summary, risk_level, impact, proposed_code_diff,
  //     proposed_commands, rollback_plan, status, requires_human_approval, executed}  (backend/app/agents/cto_authorization.py)
  //   agentId 'cmo' (publish or change something public): {action_summary, risk_level, impact, proposed_content,
  //     deployment_commands, rollback_plan, claims_to_verify, status, requires_human_approval, executed}
  //     (backend/app/agents/cmo_authorization.py)
  // NULL for every other row (all CAO and COO rows, CTO and CMO answers that propose no action, and rows written
  // before this field existed). status is always "pending_human_approval" and executed always false when written
  // (forced in code). This is the source for the future "Pending Authorizations" view; humanAction below is the
  // human's decision on it, and nothing sets it yet.
  authorizationRequest    Json?
  humanAction             HumanAction @default(Pending)
  // Phase 6 (Mission Control): WHEN and BY WHOM the decision above was recorded by POST /api/authorization/{id}/approve
  // or /reject. NULL while Pending. `timestamp` is deliberately NOT rewritten by a decision: it is the time the agent
  // answered, part of the Clause 6 accountability record.
  humanActionAt           DateTime?
  humanActionBy           String?
  timestamp               DateTime    @default(now())

  @@index([agentId, timestamp])
  @@index([userId, timestamp])
  @@index([humanAction])
}

// One row per cross-validation (agent A's recommendation reviewed by agent B).
model CrossValidationLog {
  id        Int      @id @default(autoincrement())
  agentAId  String
  agentBId  String
  query     String
  response  Json
  timestamp DateTime @default(now())

  @@index([agentAId, agentBId, timestamp])
}

// ---------- AI Executive Council Protocol (Phase 5) ----------
// Written by the Python backend (backend/app/agents/council.py, backend/app/api/council.py) with raw SQL, so
// the backend supplies the uuid. RUNNING is the state of a session in flight; the other four are terminal.
// A RUNNING row older than 5 minutes is reported as FAILED ("orphaned by restart") when polled.
enum CouncilStatus {
  RUNNING
  RESOLVED
  ESCALATED_TO_CEO
  NEEDS_CEO_INPUT
  FAILED
}

// One row per council session: the CEO's question, who took part, and everything the protocol produced.
// The council only advises: caoSynthesizedOptions are options for the CEO, and any proposed action stays
// pending_human_approval with executed false. humanAction is the CEO's decision, and nothing sets it yet.
model CouncilSessionLog {
  id                    String           @id @default(uuid())
  query                 String
  participatingAgents   String[]         @default([])
  selectionRationale    String
  status                CouncilStatus    @default(RUNNING)
  // Who disagrees with whom, per topic: [{topic, agents, positions, resolved}].
  conflictMatrix        Json?
  // Terminal hard-constraint vetoes: [{agent_id, constraint, source, overrides}].
  hardConstraintVetoes  Json?
  cooModerationNotes    String?
  // The CAO's 2-3 options for the CEO, each with its unresolved objection and the COO's red-team failure mode.
  caoSynthesizedOptions Json?
  // [{option_id, most_likely_failure_mode, ...}] from the COO's mandatory red-team check.
  redTeamFindings       Json?
  // Objections that stayed open, kept on the record on purpose.
  dissentRecord         Json?
  // Precise questions for the CEO (status NEEDS_CEO_INPUT).
  ceoQuestions          Json?
  // Why the session halted (ESCALATED_TO_CEO, FAILED).
  escalationReason      String?
  modelCalls            Int              @default(0)
  totalTokens           Int?
  startedAt             DateTime         @default(now())
  completedAt           DateTime?
  humanAction           HumanAction      @default(Pending)
  turns                 CouncilTurnLog[]

  @@index([status])
  @@index([startedAt])
  @@index([humanAction])
}

// One row per agent turn inside a council session (the moderation, revision, synthesis and red-team turns too).
model CouncilTurnLog {
  id              String            @id @default(uuid())
  sessionId       String
  session         CouncilSessionLog @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  round           Int
  agentId         String
  position        String
  // [{constraint, source}] the agent says it relies on.
  hardConstraints Json?
  // 0-100, the agent's own stated confidence.
  confidence      Int?
  sourcesCited    String[]          @default([])
  // AgentAuditLog.id when the turn was also audited, else NULL.
  auditLogId      Int?
  tokensUsed      Int?
  timestamp       DateTime          @default(now())

  @@index([sessionId, round])
  @@index([agentId, timestamp])
}

// Who changed what, and when, for every admin action.
model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  actorId    String // Clerk user id of the admin, or 'cli' for scripts
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([timestamp])
  @@index([actorId, timestamp])
}
