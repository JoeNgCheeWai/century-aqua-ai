# Server-side only: base URL of the FastAPI backend, used by the /api/* rewrite.
# In Vercel, set this to your Render URL (no trailing slash).
BACKEND_URL=http://localhost:8000

# --- Accounts (Clerk) ---
# From https://dashboard.clerk.com -> API keys. Without these the site still works
# (homepage + anonymous chat), but sign-in and the dashboard show a "not set up" notice.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Database (Prisma + PostgreSQL) ---
# Local development: run `npx prisma dev --detach --name caip-local`, then use the
# postgres:// "TCP" URL it prints, but end it with /caip_local instead of the /template1
# it shows (template1 is a Postgres system template, not a place for app data). Example:
#   postgres://postgres:postgres@localhost:51239/caip_local?sslmode=disable
# (The local prisma dev server treats every database name as the same database; the name
# matters on a real Postgres.) Production: your Neon (pooled) or Supabase URL.
DATABASE_URL=postgresql://user:password@localhost:5432/caip_local
# Local development only, and only if `prisma migrate dev` fails with "type ... already exists":
# the scratch database that `prisma dev` provides (its port is the database port + 1).
# Never set this in production.
SHADOW_DATABASE_URL=
